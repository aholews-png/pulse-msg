    "zustand": "^4.4.1",
    "react-router-dom": "^6.16.0",
    "date-fns": "^2.30.0",
    "uuid": "^9.0.0",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "nodemailer": "^6.9.6",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.1.0",
    "sqlite3": "^5.1.6",
